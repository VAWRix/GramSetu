# ==============================================================================
# GramSetu - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN LOCAL SECRETS BEFORE RUNNING
# NEVER COMMIT .env TO VERSION CONTROL
# ==============================================================================

# General / Django
DJANGO_SECRET_KEY=django-insecure-replace-with-a-secure-development-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Connection (Host & Port)
DB_HOST=127.0.0.1
DB_PORT=5433

# Initial Bootstrap / Administrator Account (Used solely during container initialization)
BOOTSTRAP_DB_USER=postgres
BOOTSTRAP_DB_PASSWORD=replace_with_bootstrap_password

# Database Names
DEV_DB_NAME=gramsetu_dev
TEST_DB_NAME=gramsetu_test

# Least-Privilege Role Credentials
# 1. Runtime Application Role (DML only, no schema creation)
APP_DB_USER=gramsetu_app
APP_DB_PASSWORD=replace_with_app_password

# 2. Schema Migration Role (Schema owner, runs migrations)
MIGRATOR_DB_USER=gramsetu_migrator
MIGRATOR_DB_PASSWORD=replace_with_migrator_password

# 3. Test Runner Role (Restricted to test database only)
TEST_DB_USER=gramsetu_test_runner
TEST_DB_PASSWORD=replace_with_test_password

# 4. Logical Backup Role (Read-all-data for pg_dump)
BACKUP_DB_USER=gramsetu_backup
BACKUP_DB_PASSWORD=replace_with_backup_password

# Active Django Connection Role ('app' for normal runtime, 'migrator' for running migrations)
DB_ROLE=app
