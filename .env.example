# ==============================================================================
# GramSetu - Comprehensive Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN LOCAL SECRETS BEFORE RUNNING LOCALLY
# FOR PRODUCTION: USE A SECURE SYSTEMD ENVIRONMENT FILE (CHMOD 0600)
# NEVER COMMIT .env TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core & Application Security
# ------------------------------------------------------------------------------
# Required in all environments. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-replace-with-a-secure-development-key

# Set to True for local development; MUST BE False in production
DJANGO_DEBUG=True

# Comma-separated list of permitted Host headers
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Logging threshold (DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Database Connection & Least-Privilege Roles (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Database Host and Port (Local Docker uses 5433; standard Linux uses 5432)
DB_HOST=127.0.0.1
DB_PORT=5433

# Initial Bootstrap Account (solely used during initial container entrypoint creation)
BOOTSTRAP_DB_USER=postgres
BOOTSTRAP_DB_PASSWORD=replace_with_bootstrap_password

# Database Names
DEV_DB_NAME=gramsetu_dev
TEST_DB_NAME=gramsetu_test

# Least-Privilege Role Credentials:
# 1. Runtime Application Role (DML only: SELECT, INSERT, UPDATE, DELETE; zero DDL)
APP_DB_USER=gramsetu_app
APP_DB_PASSWORD=replace_with_app_password

# 2. Schema Migration Role (Schema owner: DDL and migration execution)
MIGRATOR_DB_USER=gramsetu_migrator
MIGRATOR_DB_PASSWORD=replace_with_migrator_password

# 3. Test Runner Role (Restricted strictly to TEST_DB_NAME)
TEST_DB_USER=gramsetu_test_runner
TEST_DB_PASSWORD=replace_with_test_password

# 4. Logical Backup Role (Equipped with pg_read_all_data for non-locking pg_dump)
BACKUP_DB_USER=gramsetu_backup
BACKUP_DB_PASSWORD=replace_with_backup_password

# Active Django Connection Role ('app' for normal runtime, 'migrator' for running migrations)
DB_ROLE=app

# ------------------------------------------------------------------------------
# 3. Session, CSRF & Cross-Origin Security
# ------------------------------------------------------------------------------
# 30-minute session inactivity expiration (GIGW 3.0 statutory standard)
SESSION_COOKIE_AGE=1800

# Explicit origins permitted for credentialed CORS and CSRF
# NEVER use wildcard '*' for credentialed requests
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3005,http://127.0.0.1:3005
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3005,http://127.0.0.1:3005

# ------------------------------------------------------------------------------
# 4. HTTPS & Reverse Proxy Security (Production Only - Do NOT enable locally)
# ------------------------------------------------------------------------------
# Enable only when terminating behind HTTPS reverse proxy (e.g. Nginx with TLS)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_PROXY_SSL_HEADER=False

# ------------------------------------------------------------------------------
# 5. Caching & Rate Limiting
# ------------------------------------------------------------------------------
# Cache backend: 'locmem' for single-process local dev; 'db' for multi-worker production
DJANGO_CACHE_BACKEND=locmem

# ------------------------------------------------------------------------------
# 6. Transactional Email Gateway (Mandatory for Email OTP MFA)
# ------------------------------------------------------------------------------
# Local development uses console backend (prints verification codes to terminal)
# Production MUST configure live SMTP; otherwise fails closed with HTTP 503
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@gramsetu.gov.in

# ------------------------------------------------------------------------------
# 7. Multi-Factor Authentication Policies (django-otp)
# ------------------------------------------------------------------------------
OTP_EMAIL_TOKEN_VALIDITY=300
OTP_EMAIL_COOLDOWN_DURATION=60

# ------------------------------------------------------------------------------
# 8. Protected File Storage Directories (Outside Web Root)
# ------------------------------------------------------------------------------
# Storage locations for decoupled UUIDv7 binaries
# PRIVATE_DOCUMENTS_DIR=private_docs
# PRIVATE_GALLERY_DIR=private_media/gallery

# ------------------------------------------------------------------------------
# 9. Frontend Next.js Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NODE_ENV=development
PORT=3000
